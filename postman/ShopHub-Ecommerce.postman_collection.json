            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?minPrice=100&maxPrice=5000&sortBy=newest&sellerId={{sellerId}}&category=Electronics&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "5000" },
                { "key": "sortBy", "value": "newest" },
                { "key": "sellerId", "value": "{{sellerId}}" },
                { "key": "category", "value": "Electronics" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": [
            { "name": "200 OK - Products Retrieved", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Products retrieved successfully\",\n  \"data\": [\n    {\n      \"id\": \"product-001\",\n      \"name\": \"Wireless Keyboard\",\n      \"description\": \"Compact Bluetooth keyboard\",\n      \"price\": 2499,\n      \"category\": \"Electronics\",\n      \"image\": \"https://example.com/keyboard.jpg\",\n      \"sellerName\": \"Tech Basket\",\n      \"sellerId\": \"seller-001\",\n      \"rating\": 4.5,\n      \"reviews\": 120,\n      \"stock\": 50,\n      \"status\": \"approved\",\n      \"createdDate\": \"2026-05-19T10:30:00Z\"\n    }\n  ],\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" },
            { "name": "400 Bad Request - Invalid Filter", "status": "Bad Request", "code": 400, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 400,\n  \"message\": \"minPrice cannot be greater than maxPrice\",\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" }
          ]
        },
