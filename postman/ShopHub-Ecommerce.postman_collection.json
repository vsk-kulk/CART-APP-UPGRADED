        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  pm.collectionVariables.set('userId', json.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Login as user, approved seller, or admin. On 200, this request saves token and refreshToken into collection variables.",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User@123\"\n}" }
          },
          "response": [
            {
              "name": "200 OK - Login Successful",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"user-001\",\n      \"email\": \"user@example.com\",\n      \"name\": \"John Doe\",\n      \"role\": \"user\"\n    },\n    \"token\": \"jwt-token\",\n    \"refreshToken\": \"refresh-token\"\n  },\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}"
            },
            {
              "name": "401 Unauthorized - Invalid Credentials",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Invalid email or password\",\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}"
            },
            {
              "name": "403 Forbidden - Seller Pending Approval",
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"statusCode\": 403,\n  \"message\": \"Seller account is pending admin approval\",\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}"
            }
          ]
        },
