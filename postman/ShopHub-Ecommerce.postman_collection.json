              "_postman_previewlanguage": "json",
              "body": "{\n  \"error\": \"Rate limit exceeded. Please retry later.\"\n}"
            }
          ]
        },
        {
          "name": "Approximate IP Location Fallback",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
