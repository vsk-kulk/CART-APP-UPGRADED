              "body": "{\n  \"statusCode\": 201,\n  \"message\": \"User registered successfully\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"user-001\",\n      \"email\": \"user@example.com\",\n      \"name\": \"John Doe\",\n      \"role\": \"user\",\n      \"whatsappNumber\": \"+919876543210\",\n      \"createdDate\": \"2026-05-19T10:30:00Z\"\n    },\n    \"token\": \"jwt-token\",\n    \"refreshToken\": \"refresh-token\"\n  },\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}"
