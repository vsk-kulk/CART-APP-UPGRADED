            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User@123\",\n  \"name\": \"John Doe\",\n  \"role\": \"user\",\n  \"whatsappNumber\": \"+919876543210\",\n  \"aadhaarId\": \"123412341234\",\n  \"address\": {\n    \"homeOrOfficeNumber\": \"Flat 201\",\n    \"street\": \"MG Road\",\n    \"landmark\": \"Near Metro Station\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pin\": \"560001\"\n  },\n  \"geoLocation\": {\n    \"latitude\": 12.9716,\n    \"longitude\": 77.5946\n  }\n}"
            }
