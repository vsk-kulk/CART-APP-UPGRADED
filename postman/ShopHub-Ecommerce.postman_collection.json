          "response": [
            { "name": "200 OK - Product Retrieved", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Product retrieved successfully\",\n  \"data\": { \"id\": \"{{productId}}\", \"name\": \"Wireless Keyboard\" },\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" },
            { "name": "404 Not Found - Product Missing", "status": "Not Found", "code": 404, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 404,\n  \"message\": \"Product not found\",\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" }
