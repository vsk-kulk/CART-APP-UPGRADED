    {
      "name": "Frontend GeoMap Calls",
      "description": "Frontend-only map calls used by the registration page. These are not backend endpoints; they document the browser map/address lookup actions.",
      "item": [
        {
          "name": "Reverse Geocode Selected Map Point",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&lat={{geoLatitude}}&lon={{geoLongitude}}",
              "protocol": "https",
              "host": ["nominatim", "openstreetmap", "org"],
              "path": ["reverse"],
              "query": [
                { "key": "format", "value": "jsonv2" },
                { "key": "addressdetails", "value": "1" },
                { "key": "lat", "value": "{{geoLatitude}}" },
                { "key": "lon", "value": "{{geoLongitude}}" }
              ]
            },
            "description": "Used after the user clicks/drags the mini map marker. Response is mapped into Home/Office, Street, Nearby/Landmark, City, State, and Pin fields."
          },
          "response": [
            {
              "name": "200 OK - Address Details Returned",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"place_id\": 123456,\n  \"lat\": \"12.9716\",\n  \"lon\": \"77.5946\",\n  \"display_name\": \"MG Road, Bengaluru, Karnataka, 560001, India\",\n  \"address\": {\n    \"house_number\": \"201\",\n    \"road\": \"MG Road\",\n    \"suburb\": \"Central Bengaluru\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"postcode\": \"560001\",\n    \"country\": \"India\"\n  }\n}"
