          "response": [
            { "name": "200 OK - Sellers Retrieved", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Sellers retrieved successfully\",\n  \"data\": [\n    { \"id\": \"seller-001\", \"name\": \"Tech Basket\" }\n  ],\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" }
          ]
        }
      ]
