          "response": [
            { "name": "200 OK - Search Results", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Products retrieved successfully\",\n  \"data\": [],\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" },
            { "name": "400 Bad Request - Missing Query", "status": "Bad Request", "code": 400, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 400,\n  \"message\": \"Search query q is required\",\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" }
          ]
