    {
      "name": "Cart",
      "item": [
        { "name": "Get Cart", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] } }, "response": [{ "name": "200 OK - Cart Retrieved", "status": "OK", "code": 200, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 200,\n  \"message\": \"Cart retrieved successfully\",\n  \"data\": {\n    \"id\": \"{{cartId}}\",\n    \"userId\": \"{{userId}}\",\n    \"items\": [],\n    \"totalPrice\": 0,\n    \"lastUpdated\": \"2026-05-19T10:30:00Z\"\n  },\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" }, { "name": "401 Unauthorized", "status": "Unauthorized", "code": 401, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Login is required to access cart\",\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" }] },
