        {
          "name": "Register Product Seller",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Creates a product seller registration request. Website message: You submitted the new registration. Admin will review and approve it, then you can try to login. It will take 24 hrs to approve.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@example.com\",\n  \"password\": \"Seller@123\",\n  \"name\": \"Fresh Home Sellers\",\n  \"role\": \"seller\",\n  \"whatsappNumber\": \"+919876543211\",\n  \"aadhaarId\": \"123412341234\",\n  \"address\": {\n    \"homeOrOfficeNumber\": \"Shop 12\",\n    \"street\": \"Brigade Road\",\n    \"landmark\": \"Near Market Gate\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pin\": \"560025\"\n  },\n  \"geoLocation\": {\n    \"latitude\": 12.9716,\n    \"longitude\": 77.5946\n  }\n}"
            }
          },
          "response": [
            {
              "name": "201 Created - Seller Registration Submitted",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"statusCode\": 201,\n  \"message\": \"Seller registration submitted. Awaiting admin approval.\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"seller-001\",\n      \"email\": \"seller@example.com\",\n      \"name\": \"Fresh Home Sellers\",\n      \"role\": \"seller\",\n      \"status\": \"pending\",\n      \"whatsappNumber\": \"+919876543211\",\n      \"createdDate\": \"2026-05-19T10:30:00Z\"\n    }\n  },\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}"
