        {
          "name": "Seller Adds Product For Admin Approval",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "description": "Website message after product seller submits: Admin will approve the Product. It will take 24 hrs, you have to wait till then.",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Product\",\n  \"description\": \"Product description\",\n  \"price\": 999.99,\n  \"category\": \"Electronics\",\n  \"image\": \"https://example.com/product.jpg\",\n  \"stock\": 100\n}" }
          },
          "response": [
            { "name": "201 Created - Product Pending Approval", "status": "Created", "code": 201, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 201,\n  \"message\": \"Product added successfully. Awaiting admin approval.\",\n  \"data\": {\n    \"id\": \"product-002\",\n    \"name\": \"New Product\",\n    \"sellerId\": \"{{sellerId}}\",\n    \"status\": \"pending\"\n  },\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" },
            { "name": "401 Unauthorized - Seller Not Logged In", "status": "Unauthorized", "code": 401, "_postman_previewlanguage": "json", "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Missing or invalid authentication token\",\n  \"timestamp\": \"2026-05-19T10:30:00Z\"\n}" },
