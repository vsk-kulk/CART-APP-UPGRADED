          "name": "Search Products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/search?q=keyboard", "host": ["{{baseUrl}}"], "path": ["products", "search"], "query": [{ "key": "q", "value": "keyboard" }] }
